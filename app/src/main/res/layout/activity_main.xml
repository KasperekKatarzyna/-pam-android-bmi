<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:id="@+id/startImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/start_image_description"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_message"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_subtitle"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonBmi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/go_to_bmi"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/buttonCalories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/go_to_calories" />

    <Button
        android:id="@+id/buttonShoppingList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/go_to_shopping_list" />

</LinearLayout>
